FROM oven/bun:1

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl fossil git openssh-client python3 build-essential libgcc-s1 libstdc++6 ripgrep nodejs npm \
  && rm -rf /var/lib/apt/lists/*

ENV ASDF_DIR=/opt/asdf
RUN git clone https://github.com/asdf-vm/asdf.git "$ASDF_DIR" --branch v0.16.4
ENV PATH="$ASDF_DIR/bin:$ASDF_DIR/shims:$PATH"

COPY package.json bun.lock* ./
COPY packages/mimo-platform/package.json ./packages/mimo-platform/package.json
COPY packages/mimo-agent/package.json ./packages/mimo-agent/package.json

COPY packages/mimo-platform ./packages/mimo-platform
COPY packages/mimo-agent ./packages/mimo-agent
COPY .container/init-platform.sh ./.container/init-platform.sh
COPY .container/init-agent.sh ./.container/init-agent.sh

RUN chmod +x /app/.container/init-platform.sh /app/.container/init-agent.sh

RUN bun install --cwd /app/packages/mimo-platform \
  && bun install --cwd /app/packages/mimo-agent

RUN bun install

WORKDIR /app
