JWT_SECRET=replace_with_long_random_secret
OPENCODE_AGENT_JWT=replace_with_opencode_agent_jwt
CLAUDE_AGENT_JWT=replace_with_claude_agent_jwt

# Hostname used in generated platform URLs (e.g. http://MIMO_HOST:PORT).
# Set this when running behind a reverse proxy or on a different domain.
# MIMO_HOST=localhost

# Public URL agents use to reach the platform (HTTP/WebSocket).
# Defaults to http://${MIMO_HOST}:${PORT}.
# PLATFORM_URL=http://localhost:3001

# Internal hostname embedded in the clone URL sent to agents.
# Under Docker Compose this should match the platform service name.
# MIMO_INTERNAL_VCS_HOST=platform

# External base URL for the `git clone` command shown to browser users when
# deployed behind a custom domain / reverse proxy. See docs/DEPLOYMENT.md.
# MIMO_PUBLIC_VCS_URL=https://yourdomain.com/git
